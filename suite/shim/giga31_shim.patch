+
+# === GIGA FIA SHIM (onion 5c) ===
+def _giga_shim(**kw):
+    import torch
+    import torch_npu
+    q = torch.cat([kw['q_nope'], kw['q_rope']], dim=-1)   # [T,H,192]
+    k = torch.cat([kw['k_nope'], kw['k_rope']], dim=-1)   # [S,H,192]
+    v = kw['value']                                       # [S,H,192]
+    T, H, D = q.shape
+    S = k.shape[0]
+    qb = q.unsqueeze(0)                   # [1,H,T,192]
+    kb = k.unsqueeze(0)                   # [1,H,S,192]
+    vb = v.unsqueeze(0)                   # [1,H,S,192]
+    am = None
+    m = kw.get('mask')
+    if m is not None and kw.get('mask_type', 'mask_type_triu') != 'no_mask':
+        if m.shape[-2] >= T and m.shape[-1] >= S:
+            am = (m <= -1e8)[..., :T, :S]
+        else:
+            am = torch.triu(torch.ones(T, S, device=q.device, dtype=torch.bool), 1)
+        while am.dim() < 4:
+            am = am.unsqueeze(0)
+    if not getattr(_giga_shim, 'said', False):
+        print('[SHIM] file-patch active T=%s S=%s H=%s scale=%s mask_type=%s' % (T, S, H, kw.get('qk_scale'), kw.get('mask_type')), flush=True)
+        _giga_shim.said = True
+    attn = torch_npu.npu_fused_infer_attention_score(
+        qb, kb, vb, num_heads=H, num_key_value_heads=kw.get('kv_head_num', H) or H,
+        scale=kw.get('qk_scale', D ** -0.5), input_layout='BSND',
+        atten_mask=am, sparse_mode=0)
+    if isinstance(attn, (tuple, list)):
+        attn = attn[0]
+    attn = attn.squeeze(0)                # [T,H,192]
+    out = kw.get('output')
+    if out is not None:
+        out.copy_(attn.reshape(out.shape))
+        return out
+    return attn.reshape(T, H, v.shape[-1])
+
